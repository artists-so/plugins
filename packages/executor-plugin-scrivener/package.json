{
  "name": "@artists-so/executor-plugin-scrivener",
  "version": "0.1.0",
  "description": "Scrivener projects as a native Executor integration: binder read and sync, document read and write.",
  "keywords": [
    "scrivener",
    "executor",
    "executor-plugin",
    "writing",
    "manuscript",
    "ai-agent"
  ],
  "homepage": "https://artists.so",
  "bugs": {
    "url": "https://github.com/artists-so/plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artists-so/plugins.git",
    "directory": "packages/executor-plugin-scrivener"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "server.js"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/server.ts --outdir dist --target node --format esm --sourcemap=external && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "bench": "bun scripts/benchmark.ts",
    "samples": "bun scripts/sample-output.ts",
    "samples:check": "bun scripts/sample-output.ts && git diff --exit-code -- docs/tool-output.md",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@executor-js/sdk": "1.5.40",
    "fast-xml-parser": "^5.10.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.59"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "effect": "4.0.0-beta.59",
    "typescript": "^5.7.0"
  }
}
